{
  "name": "campus-event-management-platform-backend",
  "version": "1.0.0",
  "description": "Express.js and MongoDB API for the Campus Event Management Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node src/seed/seed.js",
    "seed:volume": "node src/seed/seed.js --volume",
    "seed:remove-volume": "node src/seed/seed.js --remove-volume --yes"
  },
  "keywords": [
    "mongodb",
    "express",
    "campus-events",
    "nosql",
    "aggregation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
